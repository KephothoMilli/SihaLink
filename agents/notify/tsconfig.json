{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "../../shared/types": ["../../shared/types/index.ts"]
    }
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist"]
}
