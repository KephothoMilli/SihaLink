# ============================================================
# SihaLink — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Google AI / ADK ────────────────────────────────────────
# Gemini API key for audio transcription + clinical extraction + TTS
GEMINI_API_KEY=your_gemini_api_key_here

# Google ADK — Agent Runtime deployment
# Used by: adk deploy agent-runtime
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1

# ── Google Maps ────────────────────────────────────────────
# Maps API key with Places, Directions, Geocoding APIs enabled
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── MongoDB Atlas ──────────────────────────────────────────
# Atlas connection string (M10+ cluster required for Vector Search)
MONGODB_ATLAS_URI=mongodb+srv://username:password@cluster.mongodb.net/sihalink?retryWrites=true&w=majority

# ── Telegram ───────────────────────────────────────────────
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID of the facility receiving referrals (for testing)
FACILITY_TELEGRAM_ID=your_facility_chat_id

# Webhook URL for production (leave empty for long-polling in dev)
TELEGRAM_WEBHOOK_URL=

# ── Service URLs ───────────────────────────────────────────
# URL of the Node.js Notify Agent (grammY bot HTTP server)
NOTIFY_AGENT_URL=http://localhost:3001

# Port for the Notify Agent HTTP server
NOTIFY_PORT=3001

# ── Frontend ───────────────────────────────────────────────
# Orchestrator URL used by the Angular frontend
VITE_API_URL=http://localhost:8000

# ── Firebase ───────────────────────────────────────────────
# Firebase project ID (used in environment.prod.ts)
FIREBASE_PROJECT_ID=your_firebase_project_id

# ── Google Cloud ───────────────────────────────────────────
# GCP project ID for Agent Runtime deployment
GCP_PROJECT_ID=your_gcp_project_id
GCP_REGION=us-central1

# ── Runtime ────────────────────────────────────────────────
ENVIRONMENT=development
PORT=8000
